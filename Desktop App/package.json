{
	"name": "kiosk-lock-app",
	"version": "1.0.0",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"test": "echo \"Error: no test specified\" && exit 1",
		"pack": "electron-builder --dir",
		"dist": "electron-builder",
		"postinstall": "electron-builder install-app-deps"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"description": "A kiosk-style lock screen application",
	"devDependencies": {
		"electron": "^36.0.0",
		"electron-builder": "^24.13.3"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.49.4"
	},
	"build": {
		"appId": "com.cafe.kiosklock",
		"productName": "Cafe Kiosk Lock",
		"win": {
			"target": "nsis",
			"icon": "build/icon.ico"
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"runAfterFinish": true
		}
	}
}
